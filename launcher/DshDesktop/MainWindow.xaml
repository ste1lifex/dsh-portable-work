                                <TextBlock x:Name="LoaderWordmark" Text="DeepSeek"
                                           Foreground="{DynamicResource BootTextPrimary}"
                                           FontFamily="Segoe UI, Arial" FontSize="31" FontWeight="SemiBold"
                                           VerticalAlignment="Center" Margin="14,0,0,2" />
                            </StackPanel>

                            <!-- 标语：两行「倒三角」版式 —— 第一行长、第二行短，
                                 每行都以整块宽度居中（TextAlignment=Center），
                                 所以第二行相对上面一行是居中收窄的。
                                 明确用 NoWrap：断行只由常量里的 \n 决定，
                                 不允许自动换行破坏这个形状。 -->
                            <TextBlock x:Name="LoaderSlogan"
                                       Foreground="{DynamicResource BootSloganFg}" FontSize="12.5"
                                       FontFamily="Segoe UI, Arial" HorizontalAlignment="Center"
                                       TextAlignment="Center" TextWrapping="NoWrap"
                                       Margin="0,26,0,0" />
                        </StackPanel>

                        <!-- 实时状态 + 迷你实时日志（左下角）：深/浅两套文字色 + 主题化面板底 -->
                        <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="24,0,24,22" MaxWidth="720">
                            <TextBlock x:Name="LoadingText" Text="正在启动..." Foreground="{DynamicResource BootTextPrimary}"
                                       FontSize="13.5" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock x:Name="LoadingDetail" Text="" Foreground="{DynamicResource BootTextSecondary}"
                                       FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap" MaxWidth="680" />
                            <Border Background="{DynamicResource BootSurface}" BorderBrush="{DynamicResource BootPanelBorder}"
                                    BorderThickness="1" Margin="0,10,0,0" Padding="10,6" MaxHeight="96">
                                <ScrollViewer x:Name="LoadingLogScroll" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="LoadingLogList" ItemsSource="{Binding LoadingLogLines}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Text}" Foreground="{Binding BootBrush}"
                                                           FontFamily="Consolas, Microsoft YaHei UI" FontSize="10.5"
                                                           TextWrapping="Wrap" Margin="0,0,0,2" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </StackPanel>

                        <!-- ================= 100% 之后的强调色横向 wipe 转场 =================
                             进度到 100% 且定格时长走完后，FinishTick() 用两段式幕布收尾：
                             第 1 段（420ms）Width 0 → 窗口宽（easeInOut），整屏高的强调色幕布
                               从左向右合上（宽度展开式，盖满整屏的时刻明确）；同时启动屏整体淡出；
                             第 2 段（420ms）TranslateTransform.X 0 → 窗口宽，整块幕布继续向右
                               平移滑出画面，把下面已经加载好的主界面「刷」出来。
                             幕布底色是横向蓝渐变（左深右浅）：XAML 里的 BootWipeGradient 只是
                             深色占位，ApplyBootGradients() 会用 BootRailFill / BootRailFillEnd
                             按主题现拼（浅色主题下是较亮的蓝，不会变成浅灰）。
                             结束由 EndBootWipe() 复位（Collapsed / Width=0 / X=0 / 清动画）。
                             名字 BootWipeMask / BootWipeSlide 被 MainWindow.xaml.cs 引用，别改。
                             ================================================================= -->
                        <Grid x:Name="BootWipeMask" HorizontalAlignment="Left" VerticalAlignment="Stretch"
                              Width="0" Visibility="Collapsed" IsHitTestVisible="False"
                              Background="{DynamicResource BootWipeGradient}">
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="BootWipeSlide" X="0" />
                            </Grid.RenderTransform>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

        </DockPanel>
    </Border>
</Window>
