<Application x:Class="DshDesktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>

        <!-- =====================================================================
             Palette —— 这里的颜色只是「深色默认值」。
             Theme.cs 在启动时（以及 WebUI 主题变化时）就地改写这些画刷的颜色，
             所以外壳会跟着内嵌界面一起变浅色/深色。新增颜色必须同时登记到
             Theme.cs 的 Palette 表，否则切主题时它不会变。
             ===================================================================== -->
        <SolidColorBrush x:Key="WindowBg" Color="#151517" />
        <SolidColorBrush x:Key="ChromeBg" Color="#1B1B1C" />
        <SolidColorBrush x:Key="CardBg" Color="#1B1B1C" />
        <SolidColorBrush x:Key="CardBorder" Color="#1FFFFFFF" />
        <SolidColorBrush x:Key="LogBg" Color="#0F1115" />
        <SolidColorBrush x:Key="TextPrimary" Color="#F9FAFB" />
        <SolidColorBrush x:Key="TextSecondary" Color="#CFD3D6" />
        <SolidColorBrush x:Key="TextDim" Color="#ADB2B8" />
        <SolidColorBrush x:Key="OnAccentFg" Color="#FFFFFF" />
        <!-- 强调色（DeepSeek 蓝 #4D6BFE；Theme.cs 会按深浅色改写） -->
        <SolidColorBrush x:Key="AccentBrush" Color="#4D6BFE" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#5E7BFF" />
        <SolidColorBrush x:Key="AccentPressedBrush" Color="#3A55E0" />
        <SolidColorBrush x:Key="GreenBrush" Color="#34D399" />
        <SolidColorBrush x:Key="AmberBrush" Color="#FBBF24" />
        <SolidColorBrush x:Key="RedBrush" Color="#F87171" />
        <SolidColorBrush x:Key="GrayBrush" Color="#8A8D88" />

        <SolidColorBrush x:Key="GhostBg" Color="#2C2C2E" />
        <SolidColorBrush x:Key="GhostBorder" Color="#002C2C2E" />
        <SolidColorBrush x:Key="GhostHoverBg" Color="#353638" />
        <SolidColorBrush x:Key="GhostHoverBorder" Color="#00353638" />
        <SolidColorBrush x:Key="GhostPressedBg" Color="#3E3F42" />

        <SolidColorBrush x:Key="DangerBg" Color="#26F25A5A" />
        <SolidColorBrush x:Key="DangerFg" Color="#FF8A8A" />
        <SolidColorBrush x:Key="DangerBorder" Color="#00F25A5A" />
        <SolidColorBrush x:Key="DangerHoverBg" Color="#40F25A5A" />
        <SolidColorBrush x:Key="DangerHoverBorder" Color="#00F25A5A" />
        <SolidColorBrush x:Key="DangerPressedBg" Color="#59F25A5A" />

        <SolidColorBrush x:Key="TitleHoverBg" Color="#1FFFFFFF" />
        <SolidColorBrush x:Key="TitlePressedBg" Color="#29FFFFFF" />

        <SolidColorBrush x:Key="BadgeNeutralBg" Color="#1C212B" />
        <SolidColorBrush x:Key="BadgeNeutralFg" Color="#8A94A6" />
        <SolidColorBrush x:Key="BadgeGreenBg" Color="#0E2B22" />
        <SolidColorBrush x:Key="BadgeGreenFg" Color="#34D399" />
        <SolidColorBrush x:Key="BadgeAmberBg" Color="#2E2510" />
        <SolidColorBrush x:Key="BadgeAmberFg" Color="#FBBF24" />

        <SolidColorBrush x:Key="SelectionBg" Color="#664D6BFE" />
        <SolidColorBrush x:Key="MenuBg" Color="#232324" />
        <SolidColorBrush x:Key="MenuBorder" Color="#29FFFFFF" />
        <SolidColorBrush x:Key="MenuHoverBg" Color="#2C2C2E" />
        <SolidColorBrush x:Key="MenuFg" Color="#F9FAFB" />
        <SolidColorBrush x:Key="MenuSeparator" Color="#1FFFFFFF" />

        <!-- =====================================================================
             启动屏（boot plate）配色。
             这里只写「深色默认值」占位；深浅两套的实际取值都在 Theme.cs 的
             Palette 表里（Boot* 键），切主题时就地改写这些画刷。
             启动屏 XAML 一律用 DynamicResource 引用它们，不写死颜色。
             底色严格二选一：深色 #0F1115 近黑 / 浅色 #FFFFFF 纯白，都不是蓝色；
             标志（DeepSeek 鲸鱼矢量 Path + "DeepSeek" 字标）不用颜色键：
             填充色走 BootTextPrimary，切主题由 WPF 自动重绘，没有 Logo 图片文件。
             ===================================================================== -->
        <SolidColorBrush x:Key="BootBg" Color="#0F1115" />
        <SolidColorBrush x:Key="BootSurface" Color="#16181D" />
        <SolidColorBrush x:Key="BootHairline" Color="#2A2D34" />
        <SolidColorBrush x:Key="BootTextPrimary" Color="#F5F6F7" />
        <SolidColorBrush x:Key="BootLogoFallback" Color="#F5F6F7" />
        <SolidColorBrush x:Key="BootTextSecondary" Color="#A8ADB5" />
        <SolidColorBrush x:Key="BootTextDim" Color="#6E747E" />
        <SolidColorBrush x:Key="BootSloganFg" Color="#A8ADB5" />
        <SolidColorBrush x:Key="BootPanelBorder" Color="#2A2D34" />
        <SolidColorBrush x:Key="BootRailTrack" Color="#23262C" />
        <SolidColorBrush x:Key="BootSegmentOff" Color="#2A2D34" />
        <SolidColorBrush x:Key="BootAccentInk" Color="#8FA6FF" />
        <SolidColorBrush x:Key="BootRailFill" Color="#4D6BFE" />
        <SolidColorBrush x:Key="BootRailFillEnd" Color="#8FA6FF" />
        <!-- 100% 之后横向 wipe 幕布的底色：这里只是「深色默认值」占位，
             代码 ApplyBootGradients() 会用 BootRailFill / BootRailFillEnd
             （与进度轨同一套颜色来源）现拼蓝 → 亮蓝的横向渐变，浅色主题也会重建。 -->
        <LinearGradientBrush x:Key="BootWipeGradient" StartPoint="0,0.5" EndPoint="1,0.5">
            <GradientStop Color="#4D6BFE" Offset="0" />
            <GradientStop Color="#8FA6FF" Offset="1" />
        </LinearGradientBrush>

        <!-- 启动屏迷你日志（跟随主题，深浅两套在 Theme.cs 的 BootLogPalette） -->
        <SolidColorBrush x:Key="BootLogDefault" Color="#CFD3D8" />
        <SolidColorBrush x:Key="BootLogDim" Color="#6E747E" />
        <SolidColorBrush x:Key="BootLogInfo" Color="#9BB8FF" />
        <SolidColorBrush x:Key="BootLogGood" Color="#34D399" />
        <SolidColorBrush x:Key="BootLogWarn" Color="#FBBF24" />
        <SolidColorBrush x:Key="BootLogBad" Color="#F87171" />
        <SolidColorBrush x:Key="BootLogAccent" Color="#8FA6FF" />

        <!-- ===== Text styles ===== -->
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="MetaText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <!-- ===== Buttons（圆角 8） ===== -->
        <Style x:Key="BtnBase" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource OnAccentFg}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentPressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Background" Value="{DynamicResource GhostBg}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource GhostBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource GhostHoverBg}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource GhostHoverBorder}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource GhostPressedBg}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Background" Value="{DynamicResource DangerBg}" />
            <Setter Property="Foreground" Value="{DynamicResource DangerFg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DangerBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource DangerHoverBg}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource DangerHoverBorder}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource DangerPressedBg}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 信息胶囊（底栏余额等）：网页端 chip 观感——无边框、悬停才显底 ===== -->
        <Style x:Key="ChipButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="10" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource GhostHoverBg}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource GhostPressedBg}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleButton" TargetType="Button">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TitleHoverBg}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TitlePressedBg}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 提示 / 右键菜单（跟随主题，避免深色界面里弹白菜单） ===== -->
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="{DynamicResource MenuBg}" />
            <Setter Property="Foreground" Value="{DynamicResource MenuFg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource MenuBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="HasDropShadow" Value="False" />
        </Style>

        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource MenuBg}" />
            <Setter Property="Foreground" Value="{DynamicResource MenuFg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource MenuBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="HasDropShadow" Value="False" />
        </Style>

        <Style TargetType="Separator">
            <Setter Property="Background" Value="{DynamicResource MenuSeparator}" />
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="8,4" />
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource MenuFg}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="2" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0" ContentSource="Header" RecognizesAccessKey="True"
                                                  VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{TemplateBinding InputGestureText}" Margin="20,0,0,0"
                                           Foreground="{DynamicResource TextDim}" FontSize="11" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource MenuHoverBg}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- =====================================================================
             上游遗留资源：DeepSeek 鲸鱼几何（来自 dsh-web-frontend favicon.svg）。
             DshDesktop 的启动屏用的是 MainWindow.xaml 里内联的同一份鲸鱼路径数据
             （x:Name="LoaderWhale"），并未引用本资源；本资源在 DshDesktop 项目内
             没有任何引用（grep「WhaleGeometry」只有这一处），保留只为避免误删上游文件；
             要彻底清理直接删掉这段 StreamGeometry 即可。
